# =============================================================================
# GESTOR DE ACTIVIDAD — variables de entorno
# =============================================================================
# Copia este archivo como .env.local y rellena los valores.
# En Vercel se cargan en Configuración → Environment Variables.

# --- Base de datos -----------------------------------------------------------
# La zona horaria va en la cadena: se guarda el instante exacto y se muestra en
# hora de México. Sin ella, el último domingo de octubre la 01:30 es ambigua.
DATABASE_URL="postgresql://usuario:clave@host/base?sslmode=require&options=-c%20timezone%3DAmerica%2FMexico_City"

# Las usan los scripts (ingesta, migraciones, verificación) para elegir destino
# con --produccion sin tocar DATABASE_URL. En Vercel no hacen falta.
DATABASE_URL_PRODUCCION=
DATABASE_URL_LOCAL=

# --- Autenticación -----------------------------------------------------------
# EL MISMO secreto que el portal y Deal Engine: es lo que hace que la sesión se
# comparta entre las herramientas. Si cambia, esta app deja de reconocerlas.
AUTH_SECRET=

# Credenciales de Google Cloud → APIs y servicios → Credenciales.
# Se reutiliza el cliente OAuth de las demás herramientas; solo hay que añadir
# el URI de redirección de esta:  https://<dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública. En local no hace falta (trustHost la deduce). En Vercel sí.
# AUTH_URL=https://actividad.sohersa.com

# --- Quién puede entrar ------------------------------------------------------
ALLOWED_DOMAIN=gruposohersa.com
# Correos externos autorizados, separados por comas.
ALLOWED_EMAILS=

# --- Google Sheets -----------------------------------------------------------
# Los IDs de los archivos NO van aquí: son constantes y viven en
# src/lib/google/hojas.ts. Aquí solo la credencial con la que se leen y se
# escriben, que sí cambia de un entorno a otro.
#
# Con un token de usuario (el más simple; se obtiene con el script):
#   npx tsx --env-file=.env.local scripts/autorizar-google.ts
GOOGLE_OAUTH_REFRESH_TOKEN=

# O con una cuenta de servicio, mejor para un proceso que corre solo. Hay que
# compartirle los archivos de Drive con permiso de edición.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Enlace al resto de herramientas -----------------------------------------
NEXT_PUBLIC_URL_PORTAL=http://localhost:3000

# --- Solo desarrollo ---------------------------------------------------------
# Abre la aplicación como esta persona sin pasar por Google. NO debe existir en
# producción: la aplicación la ignora si NODE_ENV es "production", pero es una
# variable que no tiene por qué viajar.
# DEV_CORREO_SIMULADO=

# Solo para PROBAR: deja que una persona se mande y apruebe su propia
# solicitud, y así recorrer el circuito completo sin una segunda cuenta.
# NUNCA en producción: la aplicación lo ignora si NODE_ENV es "production",
# pero no tiene por qué viajar.
DEV_AUTO_APROBACION=

# ── Dynamics 365 ───────────────────────────────────────────────────────────
# Alta de casos de mantenimiento. Sin estas variables el ticket se guarda
# igual, pero la pantalla avisa de que no se abrió el caso.
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_URL=https://ccad.crm.dynamics.com
DYNAMICS_CUENTA_ID=

# A quién se avisa de un ticket nuevo, separado por comas.
# Si se deja vacío: elton@gruposohersa.com y rrhh@gruposohersa.com.
TICKETS_CORREOS=

# Quién ve la bandeja de TODOS los tickets, separado por comas. Vacío = nadie
# ve los ajenos, que es el lado seguro por el que equivocarse.
TICKETS_ATIENDEN=
